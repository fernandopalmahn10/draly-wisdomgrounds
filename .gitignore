data/student-records.json
data/student-archive.json
data/student-archive.json.tmp
data/student-records.json.tmp
data/student-records.unreadable-*.json
data/teacher-presets.json
data/teachers.json
data/heartbeat.txt
# Study-guide PDFs + manifest (uploaded by teachers, live on persistent disk)
data/guides/
data/guides.json
# 🏆 HSK PIN rooms — persisted so a Render dyno restart doesn't wipe
# active classroom PINs mid-exam.
data/hsk-rooms.json
# 🔒 The key that signs simulation links and sim sessions (core/sim-lock.js): made once on the data disk. NEVER commit.
data/sim-lock.key
# 🔑 The level keys + the go-live moment (core/level-keys.js), the teacher table's one-shot facts (core/teachers.js),
# and unreadable copies kept aside: data disk only. NEVER commit.
data/level-keys.json
data/level-keys.json.tmp
data/level-keys.unreadable-*.json
data/teachers-meta.json
data/teachers.unreadable-*.json
# 🏆 La Ruta Dorada's unlock rules (core/ruta-progress.js: «El Entrenamiento está activo», the Dorado %): data disk only
data/ruta-settings.json
data/ruta-settings.json.tmp
data/ruta-settings.unreadable-*.json
# 🎯 El Entrenamiento: the rounds whose phone scores already joined an account (core/entrenamiento.js): data disk only
data/train-proofs.json
data/train-proofs.json.tmp
