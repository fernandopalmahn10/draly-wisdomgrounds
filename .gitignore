node_modules/
.DS_Store
*.log
.env
.env.local
.render-token
cloudflared.exe
# Cloud credentials — NEVER commit. Contents live in Render env vars
# (e.g. GOOGLE_TTS_CREDENTIALS_JSON), not on disk in the repo.
*-credentials.json
*service-account*.json
*draly-wisdomgrounds-*.json
google-tts-*.json
# Belt-and-suspenders: any JSON in public/ that smells like creds
public/**/*credentials*.json
public/**/*service-account*.json
# TTS cache lives on the Render persistent disk, regenerated on demand
data/tts-cache/
# Persistent runtime data (lives on Render's persistent disk, NOT in git).
# Includes student PII (sentence histories) + teacher presets.
data/student-records.json
data/teacher-presets.json
data/teachers.json
data/heartbeat.txt
# Study-guide PDFs + manifest (uploaded by teachers, live on persistent disk)
data/guides/
data/guides.json
# 🏆 HSK PIN rooms — persisted so a Render dyno restart doesn't wipe
# active classroom PINs mid-exam.
data/hsk-rooms.json
# Original (uncompressed) 3D models — only the compressed dralingo-*.glb + john-monk.glb ship to git
public/assets/Arab Dralingo flying with white ghutra.glb
public/assets/Arab Dralingo in Red F8.glb
public/assets/Chinese Emperor Dralingo with ankh and Qin Dynasty Emperor Hat.glb
public/assets/Dralingo eating characters.glb
public/assets/DralySheikh white ghutra.glb
public/assets/JohnMonkglbforTextures.glb
