    {
     "who": "profe",
     "py": "nǐ hǎo! nǐmen shì nǎ tiān lái Zhōngguó de?",
     "es": "¡Hola! ¿Qué día llegaron a China?",
     "zh": "你好！你们是哪天来中国的？"
    },
    {
     "who": "tu",
     "py": "wǒmen shì bā yuè qī hào lái Zhōngguó de.",
     "es": "Llegamos a China el 7 de agosto.",
     "zh": "我们是八月七号来中国的。"
    },
    {
     "who": "profe",
     "py": "nǐmen zěnme qù Běijīng?",
     "es": "¿Cómo van a Beijing?",
     "zh": "你们怎么去北京？"
    },
    {
     "who": "tu",
     "py": "wǒmen zuò huǒchē qù. qǐngwèn, shūdiàn zài nǎlǐ?",
     "es": "Vamos en tren. Disculpe, ¿dónde está la librería?",
     "zh": "我们坐火车去。请问，书店在哪里？"
    },
    {
     "who": "profe",
     "py": "zài zhōngxué qiánbian.",
     "es": "Está delante de la escuela secundaria.",
     "zh": "在中学前边。"
    },
    {
     "who": "tu",
     "py": "xièxie! wǒ jiào le chūzūchē.",
     "es": "¡Gracias! Pedí un taxi.",
     "zh": "谢谢！我叫了出租车。"
    },
    {
     "who": "profe",
     "py": "bú kèqi! Zhōngguó hěn hǎowánr!",
     "es": "¡De nada! ¡China es muy divertida!",
     "zh": "不客气！中国很好玩儿！"
    }
   ]
  },
