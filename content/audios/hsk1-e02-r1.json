     "who": "profe",
     "py": "nǐ hǎo! nǐ shì xuésheng ma?",
     "es": "¡Hola! ¿Eres estudiante?",
     "zh": "你好！你是学生吗？"
    },
    {
     "who": "tu",
     "py": "shì! wǒ shì xuésheng. wǒ zài Dralingo xuéxí hànyǔ.",
     "es": "¡Sí! Soy estudiante. Estudio chino en Dralingo.",
     "zh": "是！我是学生。我在德拉林戈学习汉语。"
    },
    {
     "who": "profe",
     "py": "nǐ huì shuō hànyǔ ma?",
     "es": "¿Sabes hablar chino?",
     "zh": "你会说汉语吗？"
    },
    {
     "who": "tu",
     "py": "huì yìdiǎnr! wǒ huì shuō, wǒ huì dú.",
     "es": "¡Sé un poquito! Sé hablar, sé leer.",
     "zh": "会一点儿！我会说，我会读。"
    },
    {
     "who": "profe",
     "py": "zhège zì nǐ huì xiě ma?",
     "es": "¿Sabes escribir este carácter?",
     "zh": "这个字你会写吗？"
    },
    {
     "who": "tu",
     "py": "zhège zì wǒ bù huì xiě… wǒ hěn xǐhuan zhè běn shū!",
     "es": "Este no sé escribirlo… ¡pero me encanta este libro!",
     "zh": "这个字我不会写……我很喜欢这本书！"
    },
    {
     "who": "profe",
     "py": "nǐ de hànyǔ hěn hǎo! míngtiān xuéxiào jiàn!",
     "es": "¡Tu chino es muy bueno! ¡Nos vemos mañana en la escuela!",
     "zh": "你的汉语很好！明天学校见！"
    }
   ]
