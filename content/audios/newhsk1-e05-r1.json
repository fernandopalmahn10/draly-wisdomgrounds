     "who": "profe",
     "py": "nǐ hǎo! nǐ nàr xiànzài jǐ diǎn?",
     "es": "¡Hola! ¿Qué hora es allá?",
     "zh": "你好！你那儿现在几点？"
    },
    {
     "who": "tu",
     "py": "xiànzài qī diǎn bàn. wǒ chuān yīfu.",
     "es": "Son las siete y media. Me estoy vistiendo.",
     "zh": "现在七点半。我穿衣服。"
    },
    {
     "who": "profe",
     "py": "nǐ de zǎofàn shì shénme?",
     "es": "¿Qué desayunas?",
     "zh": "你的早饭是什么？"
    },
    {
     "who": "tu",
     "py": "wǒ de zǎofàn shì miàntiáor.",
     "es": "Mi desayuno son fideos.",
     "zh": "我的早饭是面条儿。"
    },
    {
     "who": "profe",
     "py": "jīntiān tiānqì zěnmeyàng?",
     "es": "¿Qué tiempo hace hoy?",
     "zh": "今天天气怎么样？"
    },
    {
     "who": "tu",
     "py": "xià yǔ le, hěn lěng! wǒ zài fángjiān lǐ xiūxi.",
     "es": "¡Llueve y hace frío! Descanso en mi cuarto.",
     "zh": "下雨了，很冷！我在房间里休息。"
    },
    {
     "who": "profe",
     "py": "wǒ zhèr fēicháng rè! zàijiàn!",
     "es": "¡Aquí hace muchísimo calor! ¡Adiós!",
     "zh": "我这儿非常热！再见！"
    }
   ]
