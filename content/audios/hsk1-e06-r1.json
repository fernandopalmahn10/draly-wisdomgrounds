    },
    {
     "who": "tu",
     "py": "shì! zhè shì wǒ de jiā.",
     "es": "¡Sí! Esta es mi casa.",
     "zh": "是！这是我的家。"
    },
    {
     "who": "profe",
     "py": "nǐ jiā lǐ yǒu shénme?",
     "es": "¿Qué hay en tu casa?",
     "zh": "你家里有什么？"
    },
    {
     "who": "tu",
     "py": "jiā lǐ yǒu zhuōzi, yǒu yǐzi. zhuōzi shàng yǒu diànnǎo.",
     "es": "Hay una mesa y sillas. Sobre la mesa hay una computadora.",
     "zh": "家里有桌子，有椅子。桌子上有电脑。"
    },
    {
     "who": "profe",
     "py": "yǒu diànshì ma?",
     "es": "¿Hay tele?",
     "zh": "有电视吗？"
    },
    {
     "who": "tu",
     "py": "yǒu! wǒ kāi diànshì, wǒmen kàn diànshì!",
     "es": "¡Sí! Prendo la tele, ¡vemos la tele!",
     "zh": "有！我开电视，我们看电视！"
    },
    {
     "who": "profe",
     "py": "hǎo! nǐ de jiā hěn dà!",
     "es": "¡Qué bien! ¡Tu casa es muy grande!",
     "zh": "好！你的家很大！"
