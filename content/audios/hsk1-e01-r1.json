     "who": "profe",
     "py": "nǐ hǎo! nǐ jiào shénme míngzi?",
     "es": "¡Hola! ¿Cómo te llamas?",
     "zh": "你好！你叫什么名字？"
    },
    {
     "who": "tu",
     "py": "nǐ hǎo! wǒ jiào Dani. hěn gāoxìng rènshi nǐ!",
     "es": "¡Hola! Me llamo Dani. ¡Mucho gusto!",
     "zh": "你好！我叫达妮。很高兴认识你！"
    },
    {
     "who": "profe",
     "py": "wǒ yě hěn gāoxìng rènshi nǐ. nǐ xǐhuan māo ma?",
     "es": "Yo también. ¿Te gustan los gatos?",
     "zh": "我也很高兴认识你。你喜欢猫吗？"
    },
    {
     "who": "tu",
     "py": "wǒ xǐhuan māo. wǒ bù xǐhuan gǒu!",
     "es": "Me gustan los gatos. ¡No me gustan los perros!",
     "zh": "我喜欢猫。我不喜欢狗！"
    },
    {
     "who": "tu",
     "py": "zhè shì wǒ bàba, zhè shì wǒ māma.",
     "es": "Este es mi papá, esta es mi mamá.",
     "zh": "这是我爸爸，这是我妈妈。"
    },
    {
     "who": "profe",
     "py": "hǎo! xièxie, Dani. zàijiàn!",
     "es": "¡Muy bien! Gracias, Dani. ¡Adiós!",
     "zh": "好！谢谢，达妮。再见！"
    },
    {
