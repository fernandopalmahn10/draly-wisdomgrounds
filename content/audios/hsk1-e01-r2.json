     "who": "profe",
     "py": "xiǎopéngyǒu, nǐ jiào shénme míngzi? nǐ jǐ suì le?",
     "es": "Pequeño, ¿cómo te llamas? ¿Cuántos años tienes?",
     "zh": "小朋友，你叫什么名字？你几岁了？"
    },
    {
     "who": "tu",
     "py": "wǒ jiào Dani, wǒ bā suì.",
     "es": "Me llamo Dani, tengo ocho años.",
     "zh": "我叫达妮，我八岁。"
    },
    {
     "who": "profe",
     "py": "tā shì shéi?",
     "es": "¿Quién es él?",
     "zh": "他是谁？"
    },
    {
     "who": "tu",
     "py": "zhè shì wǒ de péngyou, tā jiào Leo.",
     "es": "Este es mi amigo, se llama Leo.",
     "zh": "这是我的朋友，他叫利奥。"
    },
    {
     "who": "profe",
     "py": "nàge xiǎo gǒu shì shéi de?",
     "es": "¿De quién es ese perrito?",
     "zh": "那个小狗是谁的？"
    },
    {
