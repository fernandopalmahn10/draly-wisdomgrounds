     "py": "wǒ xiǎng mǎi píngguǒ. zhèxiē dōngxi duōshǎo qián?",
     "es": "Quiero comprar manzanas. ¿Cuánto cuestan estas cosas?",
     "zh": "我想买苹果。这些东西多少钱？"
    },
    {
     "who": "profe",
     "py": "èrshí kuài.",
     "es": "Veinte yuanes.",
     "zh": "二十块。"
    },
    {
     "who": "tu",
     "py": "hǎo! wǒ hěn xǐhuan chī shuǐguǒ!",
     "es": "¡Bien! ¡Me encanta comer fruta!",
     "zh": "好！我很喜欢吃水果！"
    },
    {
     "who": "profe",
     "py": "nǐ hē shuǐ ma?",
     "es": "¿Bebes agua?",
     "zh": "你喝水吗？"
    },
    {
