     "py": "wǒ xiǎng hē chá. xièxie!",
     "es": "Quiero beber té. ¡Gracias!",
     "zh": "我想喝茶。谢谢！"
    },
    {
     "who": "profe",
     "py": "bú kèqì! zàijiàn!",
     "es": "¡De nada! ¡Adiós!",
     "zh": "不客气！再见！"
