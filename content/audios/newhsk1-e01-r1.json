     "who": "profe",
     "py": "dàjiā hǎo! jīntiān shì shéi de shēngrì?",
     "es": "¡Hola a todos! ¿De quién es el cumpleaños hoy?",
     "zh": "大家好！今天是谁的生日？"
    },
    {
     "who": "tu",
     "py": "shì wǒ de shēngrì! wǒ jiào Dani.",
     "es": "¡Es mi cumpleaños! Me llamo Dani.",
     "zh": "是我的生日！我叫达妮。"
    },
    {
     "who": "profe",
     "py": "shēngrì kuàilè, Dani! tāmen shì shéi?",
     "es": "¡Feliz cumpleaños, Dani! ¿Quiénes son?",
     "zh": "生日快乐，达妮！他们是谁？"
    },
    {
     "who": "tu",
     "py": "wǒ jièshào wǒ de jiā. zhè shì wǒ gēge, zhè shì wǒ jiějie.",
     "es": "Les presento a mi familia. Mi hermano mayor y mi hermana mayor.",
     "zh": "我介绍我的家。这是我哥哥，这是我姐姐。"
    },
    {
     "who": "tu",
     "py": "zhè shì wǒ dìdi, zhè shì wǒ mèimei.",
     "es": "Mi hermano menor y mi hermana menor.",
     "zh": "这是我弟弟，这是我妹妹。"
    },
    {
     "who": "profe",
     "py": "hǎo! shēngrì kuàilè!",
     "es": "¡Muy bien! ¡Feliz cumpleaños!",
     "zh": "好！生日快乐！"
    },
    {
     "who": "tu",
     "py": "xièxie nín! wǒ hěn kuàilè!",
     "es": "¡Gracias (usted)! ¡Estoy muy feliz!",
     "zh": "谢谢您！我很快乐！"
    }
