     "who": "profe",
     "py": "nǐ hǎo! wǒ shì Wáng xiānsheng.",
     "es": "¡Hola! Soy el señor Wáng.",
     "zh": "你好！我是王先生。"
    },
    {
     "who": "tu",
     "py": "Wáng xiānsheng, nǐ hǎo! zhè shì wǒ tóngxué.",
     "es": "¡Hola, señor Wáng! Esta es mi compañera.",
     "zh": "王先生，你好！这是我同学。"
    },
    {
     "who": "profe",
     "py": "nǐmen zài xuéxiào xuéxí shénme?",
     "es": "¿Qué estudian en la escuela?",
     "zh": "你们在学校学习什么？"
    },
    {
     "who": "tu",
     "py": "wǒmen xuéxí hànyǔ. wǒ tīng lǎoshī, wǒ kàn shū.",
     "es": "Estudiamos chino. Escucho a la profe, miro el libro.",
     "zh": "我们学习汉语。我听老师，我看书。"
    },
    {
     "who": "profe",
     "py": "nǐ kànjiàn shénme? nǐ néng shuō hànyǔ ma?",
     "es": "¿Qué ves? ¿Puedes hablar chino?",
     "zh": "你看见什么？你能说汉语吗？"
    },
    {
     "who": "tu",
     "py": "wǒ kànjiàn sān běn shū! wǒ néng shuō yìdiǎnr.",
     "es": "¡Veo tres libros! Puedo hablar un poquito.",
     "zh": "我看见三本书！我能说一点儿。"
    },
    {
     "who": "profe",
     "py": "hěn hǎo! míngtiān jiàn!",
     "es": "¡Muy bien! ¡Hasta mañana!",
     "zh": "很好！明天见！"
    }
