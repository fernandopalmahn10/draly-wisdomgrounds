     "py": "tā shì yīshēng. tā zài yīyuàn gōngzuò.",
     "es": "Es doctor. Trabaja en el hospital.",
     "zh": "他是医生。他在医院工作。"
    },
    {
     "who": "profe",
     "py": "nǐ zěnme qù yīyuàn?",
     "es": "¿Cómo vas al hospital?",
     "zh": "你怎么去医院？"
