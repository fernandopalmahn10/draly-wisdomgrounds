     "py": "wǒ zuò chūzūchē qù.",
     "es": "Voy en taxi.",
     "zh": "我坐出租车去。"
    },
    {
     "who": "profe",
     "py": "nǐ de hànyǔ zěnmeyàng?",
     "es": "¿Qué tal tu Chino Mandarín?",
     "zh": "你的汉语怎么样？"
